#: ui/main.qml:18
#, kde-format
msgid "Shell"
msgstr "Školjka"

#: ui/main.qml:27
#, kde-format
msgid "General"
msgstr "Opšte"

#: ui/main.qml:33 ui/VibrationForm.qml:18 ui/VibrationForm.qml:25
#, kde-format
msgid "Shell Vibrations"
msgstr "Vibracije školjke"

#: ui/main.qml:41
#, kde-format
msgid "Animations"
msgstr "Animacije"

#: ui/main.qml:42
#, kde-format
msgid "If this is off, animations will be reduced as much as possible."
msgstr "Ako je ovo isključeno, animacije će biti svedene na najmanju mjeru."

#: ui/main.qml:55
#, kde-format
msgid "Auto Hide Panels"
msgstr "Automatsko sakrivanje panela"

#: ui/main.qml:56
#, kde-format
msgid ""
"Auto-hide the status and navigation panels to allow applications to always "
"be in fullscreen."
msgstr ""
"Automatski sakriva panele stanja i navigacije, da bi programi uvijek mogli "
"da budu preko cijelog ekrana."

#: ui/main.qml:69
#, kde-format
msgid "Double Tap to Wakeup"
msgstr "Buđenje dvostrukim tapom"

#: ui/main.qml:70
#, kde-format
msgid "When the screen is off, double tap to wakeup the device."
msgstr "Kad je ekran isključen, dvostruko tapnite da probudite uređaj."

#: ui/main.qml:81
#, kde-format
msgid "Status Bar"
msgstr "Traka stanja"

#: ui/main.qml:87
#, kde-format
msgid "Date in status bar"
msgstr "Datum na traci stanja"

#: ui/main.qml:88
#, kde-format
msgid "If on, date will be shown next to the clock in the status bar."
msgstr "Ako je uključeno, datum se prikazuje pored sata na traci stanja."

#: ui/main.qml:101
#, kde-format
msgid "Battery Percentage"
msgstr "Procenat baterije"

#: ui/main.qml:102
#, kde-format
msgid "Show battery percentage in the status bar."
msgstr "Prikaži procenat baterije na traci stanja."

