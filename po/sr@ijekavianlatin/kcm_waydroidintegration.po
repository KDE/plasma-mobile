msgstr "Provjeri instalaciju"

#: ui/main.qml:51
#, kde-format
msgid ""
"Downloading Android and vendor images.\n"
"It can take a few minutes."
msgstr ""
"Preuzimam odraze Androida i proizvođača.\n"
"Može potrajati nekoliko minuta."

#: ui/main.qml:66
#, kde-format
msgid ""
"Waydroid is resetting.\n"
"It can take a few seconds."
msgstr ""
"Waydroid se resetuje.\n"
"Može potrajati nekoliko sekundi."

#: ui/main.qml:75
#, kde-format
msgid "The Waydroid session is not running."
msgstr "Sesija Waydroid‑a nije pokrenuta."

#: ui/main.qml:81
