msgstr "Režim fioke iz gornjeg levog ugla"

#: ui/main.qml:174
#, kde-format
msgid "Mode when opening from the top left."
msgstr "Režim pri otvaranju iz gornjeg levog ugla."

#: ui/main.qml:195
#, kde-format
msgid "Top Right Drawer Mode"
msgstr "Režim fioke iz gornjeg desnog ugla"

#: ui/main.qml:196
#, kde-format
msgid "Mode when opening from the top right."
msgstr "Režim pri otvaranju iz gornjeg desnog ugla."

