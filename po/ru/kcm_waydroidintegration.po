#: ui/main.qml:18
#, kde-format
msgid "Waydroid Integration"
msgstr "Интеграция с Waydroid"

#: ui/main.qml:31
#, kde-format
msgid "Waydroid is not installed"
msgstr "Waydroid не установлен"

#: ui/main.qml:38
#, kde-format
msgid "Check installation"
msgstr "Проверить установку"

#: ui/main.qml:51
#, kde-format
msgid ""
"Downloading Android and vendor images.\n"
"It can take a few minutes."
msgstr ""
"Загрузка образов Android и производителя.\n"
"Это может занять несколько минут."

#: ui/main.qml:66
#, kde-format
msgid ""
"Waydroid is resetting.\n"
"It can take a few seconds."
msgstr ""
"Выполняется сброс Waydroid.\n"
"Это может занять несколько секунд."

#: ui/main.qml:75
#, kde-format
msgid "The Waydroid session is not running."
msgstr "Сеанс Waydroid не запущен."

#: ui/main.qml:81
#, kde-format
msgid "Start the session"
msgstr "Запустить сеанс"

#: ui/main.qml:89
#, kde-format
msgid ""
"Waydroid session is starting.\n"
"It can take a few seconds."
msgstr ""
"Сеанс Waydroid запускается.\n"
"Это может занять несколько секунд."

#: ui/WaydroidApplicationsPage.qml:24
#, kde-format
msgid "Waydroid applications"
msgstr "Приложения Waydroid"

#: ui/WaydroidApplicationsPage.qml:28
#, kde-format
msgctxt "@action:button"
msgid "Install APK"
msgstr "Установить APK"

#: ui/WaydroidApplicationsPage.qml:66
#, kde-format
msgid "You must select a local file"
msgstr "Необходимо выбрать локальный файл"

#: ui/WaydroidApplicationsPage.qml:106
#, kde-format
msgctxt "@action:button"
msgid "Delete the application"
msgstr "Удалить приложение"

#: ui/WaydroidConfigurationForm.qml:19
#, kde-format
msgid "General information"
msgstr "Общие сведения"

#: ui/WaydroidConfigurationForm.qml:24
#, kde-format
