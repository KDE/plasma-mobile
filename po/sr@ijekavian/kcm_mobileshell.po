#: ui/main.qml:18
#, kde-format
msgid "Shell"
msgstr "Шкољка"

#: ui/main.qml:27
#, kde-format
msgid "General"
msgstr "Опште"

#: ui/main.qml:33 ui/VibrationForm.qml:18 ui/VibrationForm.qml:25
#, kde-format
msgid "Shell Vibrations"
msgstr "Вибрације шкољке"

#: ui/main.qml:41
#, kde-format
msgid "Animations"
msgstr "Анимације"

#: ui/main.qml:42
#, kde-format
msgid "If this is off, animations will be reduced as much as possible."
msgstr "Ако је ово искључено, анимације ће бити сведене на најмању мјеру."

#: ui/main.qml:55
#, kde-format
msgid "Auto Hide Panels"
msgstr "Аутоматско сакривање панела"

#: ui/main.qml:56
#, kde-format
msgid ""
"Auto-hide the status and navigation panels to allow applications to always "
"be in fullscreen."
msgstr ""
"Аутоматски сакрива панеле стања и навигације, да би програми увијек могли да "
"буду преко цијелог екрана."

#: ui/main.qml:69
#, kde-format
msgid "Double Tap to Wakeup"
msgstr "Буђење двоструким тапом"

#: ui/main.qml:70
#, kde-format
msgid "When the screen is off, double tap to wakeup the device."
msgstr "Кад је екран искључен, двоструко тапните да пробудите уређај."

#: ui/main.qml:83
#, kde-format
msgid "Confirm Close All"
msgstr "Потврда затварања свих"

#: ui/main.qml:84
#, kde-format
msgid "Require confirmation before closing all apps in the task switcher."
msgstr "Тражи потврду прије затварања свих програма у мјењачу задатака."

#: ui/main.qml:95
#, kde-format
msgid "Status Bar"
msgstr "Трака стања"

#: ui/main.qml:101
#, kde-format
msgid "Date in status bar"
msgstr "Датум на траци стања"

#: ui/main.qml:102
#, kde-format
msgid "If on, date will be shown next to the clock in the status bar."
msgstr "Ако је укључено, датум се приказује поред сата на траци стања."

#: ui/main.qml:115
#, kde-format
msgid "Battery Percentage"
msgstr "Проценат батерије"

#: ui/main.qml:116
#, kde-format
msgid "Show battery percentage in the status bar."
msgstr "Прикажи проценат батерије на траци стања."

#: ui/main.qml:130
#, kde-format
msgid "Status Bar Size"
msgstr "Величина траке стања"

#: ui/main.qml:131
#, kde-format
msgid "Size of the top panel (needs restart)."
msgstr "Величина горњег панела (захтијева поновно покретање)."

#: ui/main.qml:134
#, kde-format
msgctxt "Status bar height"
msgid "Tiny"
msgstr "сићушна"

#: ui/main.qml:135
#, kde-format
msgctxt "Status bar height"
msgid "Small"
msgstr "мала"

#: ui/main.qml:136
#, kde-format
msgctxt "Status bar height"
msgid "Normal"
msgstr "нормална"

#: ui/main.qml:137
#, kde-format
msgctxt "Status bar height"
msgid "Large"
msgstr "велика"

#: ui/main.qml:138
#, kde-format
msgctxt "Status bar height"
msgid "Very Large"
msgstr "врло велика"

#: ui/main.qml:154
#, kde-format
msgid "Action Drawer"
msgstr "Фиока радњи"

#: ui/main.qml:160
#, kde-format
msgctxt "Pinned action drawer mode"
msgid "Pinned Mode"
msgstr "прикачени режим"

#: ui/main.qml:161
#, kde-format
msgctxt "Expanded action drawer mode"
msgid "Expanded Mode"
msgstr "раширени режим"

#: ui/main.qml:165 ui/QuickSettingsForm.qml:20 ui/QuickSettingsForm.qml:106
#, kde-format
msgid "Quick Settings"
msgstr "Брзе поставке"

#: ui/main.qml:173
#, kde-format
msgid "Top Left Drawer Mode"
msgstr "Режим фиоке из горњег лијевог угла"

#: ui/main.qml:174
#, kde-format
msgid "Mode when opening from the top left."
msgstr "Режим при отварању из горњег лијевог угла."

#: ui/main.qml:195
#, kde-format
msgid "Top Right Drawer Mode"
msgstr "Режим фиоке из горњег десног угла"

#: ui/main.qml:196
#, kde-format
msgid "Mode when opening from the top right."
msgstr "Режим при отварању из горњег десног угла."

#: ui/main.qml:215
#, kde-format
msgctxt "@title:group, shortcuts available from lock screen"
msgid "Lock Screen Shortcuts"
msgstr "Пречице на закључаном екрану"

#: ui/main.qml:220
#, kde-format
msgctxt "@item:inlistbox"
msgid "None"
msgstr "ништа"

#: ui/main.qml:221
#, kde-format
msgctxt "@item:inlistbox"
msgid "Flashlight"
msgstr "батеријска лампа"

#: ui/main.qml:222
#, kde-format
msgctxt "@item:inlistbox"
msgid "Camera"
msgstr "фотоапарат"

#: ui/main.qml:226
#, kde-format
msgctxt "@label:listbox"
msgid "Left button"
msgstr "Лијево дугме"

#: ui/main.qml:248
#, kde-format
msgctxt "@label:listbox"
msgid "Right button"
msgstr "Десно дугме"

#: ui/QuickSettingsForm.qml:89
#, kde-format
msgctxt "@action:button"
msgid "Hide"
msgstr "Сакриј"

#: ui/QuickSettingsForm.qml:89
#, kde-format
msgctxt "@action:button"
msgid "Show"
msgstr "Прикажи"

#: ui/QuickSettingsForm.qml:114
#, kde-format
msgid "Quick Settings Columns"
msgstr "Колоне брзих поставки"

#: ui/QuickSettingsForm.qml:115
#, kde-format
msgid "Maximum number of columns in landscape orientation."
msgstr "Највећи број колона у пејзажном усмјерењу."

#: ui/QuickSettingsForm.qml:128
#, kde-format
msgid ""
"Customize the order of quick settings in the pull-down panel and hide them."
msgstr ""
"Прилагодите редослијед брзих поставки у падајућем панелу или их сакријте."

#: ui/QuickSettingsForm.qml:166
#, kde-format
msgid "Disabled Quick Settings"
msgstr "Искључене брзе поставке"

#: ui/QuickSettingsForm.qml:171
#, kde-format
msgid "Re-enable previously disabled quick settings."
msgstr "Поново укључите претходно искључене брзе поставке."

#: ui/VibrationForm.qml:26
#, kde-format
msgid "Whether to have vibrations enabled in the shell."
msgstr "Да ли су вибрације у шкољци укључене."

#: ui/VibrationForm.qml:39
#, kde-format
msgid "Vibration duration (ms)"
msgstr "Трајање вибрације (ms)"

#: ui/VibrationForm.qml:40
#, kde-format
msgid "How long shell vibrations should be."
msgstr "Колико дуго трају вибрације шкољке."

#: ui/VibrationForm.qml:55
#, kde-format
msgid "Reset to default duration"
msgstr "Врати на подразумијевано трајање"

#: ui/VibrationForm.qml:65
#, kde-format
msgid ""
"Keyboard vibrations are controlled separately in the keyboard settings "
"module."
msgstr ""
"Вибрације тастатуре подешавају се засебно, у модулу поставки тастатуре."
