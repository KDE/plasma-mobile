#, kde-format
msgid "General information"
msgstr "Општи подаци"

#: ui/WaydroidConfigurationForm.qml:24
#, kde-format
msgid "IP address"
msgstr "ИП адреса"

#: ui/WaydroidConfigurationForm.qml:28
#, kde-format
msgid "Copy"
msgstr "Копирај"

#: ui/WaydroidConfigurationForm.qml:37
#, kde-format
msgid "Waydroid status"
msgstr "Стање Waydroid‑а"

#: ui/WaydroidConfigurationForm.qml:39
#, kde-format
msgid "Stopping..."
msgstr "Заустављам..."

#: ui/WaydroidConfigurationForm.qml:40
#, kde-format
