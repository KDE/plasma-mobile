#: ui/main.qml:18
#, kde-format
msgid "Waydroid Integration"
msgstr "Уклапање Waydroid‑а"

#: ui/main.qml:31
#, kde-format
msgid "Waydroid is not installed"
msgstr "Waydroid није инсталиран"

#: ui/main.qml:38
#, kde-format
msgid "Check installation"
msgstr "Провери инсталацију"

#: ui/main.qml:51
#, kde-format
msgid ""
"Downloading Android and vendor images.\n"
"It can take a few minutes."
msgstr ""
"Преузимам одразе Андроида и произвођача.\n"
"Може потрајати неколико минута."

#: ui/main.qml:66
#, kde-format
msgid ""
"Waydroid is resetting.\n"
"It can take a few seconds."
msgstr ""
"Waydroid се ресетује.\n"
"Може потрајати неколико секунди."

#: ui/main.qml:75
#, kde-format
msgid "The Waydroid session is not running."
msgstr "Сесија Waydroid‑а није покренута."

#: ui/main.qml:81
#, kde-format
msgid "Start the session"
msgstr "Покрени сесију"

#: ui/main.qml:89
#, kde-format
msgid ""
"Waydroid session is starting.\n"
"It can take a few seconds."
msgstr ""
"Сесија Waydroid‑а се покреће.\n"
"Може потрајати неколико секунди."

#: ui/WaydroidApplicationsPage.qml:24
#, kde-format
msgid "Waydroid applications"
msgstr "Програми Waydroid‑а"

#: ui/WaydroidApplicationsPage.qml:28
#, kde-format
msgctxt "@action:button"
msgid "Install APK"
msgstr "Инсталирај APK"

#: ui/WaydroidApplicationsPage.qml:66
#, kde-format
msgid "You must select a local file"
msgstr "Морате изабрати локални фајл"

#: ui/WaydroidApplicationsPage.qml:106
#, kde-format
msgctxt "@action:button"
msgid "Delete the application"
msgstr "Обриши програм"

